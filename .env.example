# HealthVault AI - Environment Configuration Example
# Academic Software Engineering Project

# PostgreSQL Database Connection String for Prisma ORM
DATABASE_URL="postgresql://postgres:password@localhost:5432/healthvault_db?schema=public"

# Session & JWT Secret (Generate with openssl rand -base64 32)
JWT_SECRET="super-secure-healthvault-session-key-example"

# Node Environment
NODE_ENV="development"

# GEMINI_API_KEY: Optional external AI API key for enhanced medical summaries
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where the platform is deployed
APP_URL="https://localhost:3000"
